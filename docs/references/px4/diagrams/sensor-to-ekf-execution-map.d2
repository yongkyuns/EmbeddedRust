# PX4 b798249a; NuttX flat build; SENS_IMU_MODE=1. Not a firmware timing trace.
# Wiring rule: regular ELK graphs inside each row, never cross-grid connections.
vars: { d2-config: { layout-engine: elk; theme-id: 0 } }
grid-columns: 1
vertical-gap: 14
style.fill: "#FFFFFF"
classes: {
  plain: { style: { fill: "transparent"; stroke: "transparent" } }
  hw: { style: { fill: "#ECEFF1"; stroke: "#607D8B"; font-color: "#263238"; border-radius: 10; font-size: 26; bold: false } }
  a: { style: { fill: "#E8F5E9"; stroke: "#388E3C"; font-color: "#1B5E20"; border-radius: 10; font-size: 26; bold: false } }
  b: { style: { fill: "#E8EAF6"; stroke: "#5C6BC0"; font-color: "#283593"; border-radius: 10; font-size: 26; bold: false } }
  c: { style: { fill: "#FFF3E0"; stroke: "#FB8C00"; font-color: "#6D4C41"; border-radius: 10; font-size: 26; bold: false } }
  d: { style: { fill: "#F3E5F5"; stroke: "#AB47BC"; font-color: "#6A1B9A"; border-radius: 10; font-size: 26; bold: false } }
  e: { style: { fill: "#E3F2FD"; stroke: "#1E88E5"; font-color: "#0D47A1"; border-radius: 10; font-size: 26; bold: false } }
  topic: { style: { fill: "#E0F2F1"; stroke: "#00897B"; font-color: "#004D40"; border-radius: 10; font-size: 26; bold: false } }
  data: { style: { stroke: "#00897B"; font-color: "#00695C"; stroke-width: 3; font-size: 24 } }
  wake: { style: { stroke: "#E65100"; font-color: "#BF360C"; stroke-dash: 5; stroke-width: 3; font-size: 24 } }
  io: { style: { stroke: "#607D8B"; font-color: "#455A64"; stroke-width: 3; font-size: 24 } }
  call: { style: { stroke: "#5C6BC0"; font-color: "#3949AB"; stroke-width: 2; font-size: 24 } }
}

title: "PX4 sensor-to-EKF execution map" { shape: text; style: { font-size: 38; bold: true; font-color: "#163047" } }
scope: "4 processing contexts: A SPI worker  ·  B INS0 worker  ·  C navigation worker  ·  D GPS task\nRepeated A/B/C/D labels below refer to the SAME threads, not additional loops." { shape: text; style: { font-size: 26; font-color: "#455A64" } }
entry: "HARDWARE / NUTTX I/O — no HPWORK / LPWORK relay in the shown IMU path" {
 class: plain
 style: { font-size: 26; font-color: "#455A64" }
 grid-columns: 2
 horizontal-gap: 30
 imu: "" {
  class: plain
  direction: right
  device: "SPI IMU\nDRDY interrupt" {class: hw; width: 265; height: 125}
  worker: "A · wq:SPIx\nDriver becomes runnable\nSPI FIFO read via NuttX" {class: a; width: 340; height: 125}
  device -> worker: "timestamp +\nScheduleNow()" {class: wake}
 }
 gnss: "" {
  class: plain
  direction: right
  uart: "GNSS / NuttX UART\nIRQ + receive buffer" {class: hw; width: 285; height: 125}
  task: "D · GPS task\nBlocking receive resumes\nUBX / NMEA parsing" {class: d; width: 340; height: 125}
  uart -> task: "bytes +\nread/poll wake" {class: io}
 }
}
imu: "IMU PATH — separate payload and wakeup wires; each arrow stays between adjacent stages" {
 class: plain
 style: { font-size: 26; font-color: "#163047" }
 direction: right
 driver: "A · wq:SPIx\nICM42688P::RunImpl()\nRead / check FIFO\nPublish sensor reports" {class: a; width: 320; height: 185}
 integrate: "B · wq:INS0\nVehicleIMU::Run()\nRead accel + gyro\nIntegrate delta angle / velocity" {class: b; width: 365; height: 185}
 vote: "C · navigation worker\nSensors::Run()\nSelect / vote IMU\nPublish selected sample" {class: c; width: 320; height: 185}
 estimate: "B · SAME wq:INS0\nEKF2::Run()\nIngest IMU; propagate output\nMain EKF step when ready" {class: b; width: 350; height: 185}
 driver -> integrate: "sensor_accel\nsensor_gyro" {class: data}
 driver -> integrate: "gyro callback" {class: wake}
 integrate -> vote: "vehicle_imu" {class: data}
 integrate -> vote: "schedule Sensors" {class: wake}
 vote -> estimate: "sensor_combined" {class: data}
 vote -> estimate: "schedule EKF2" {class: wake}
}
gnss: "GNSS PATH — acquisition is independent; EKF2 reads GNSS during an IMU-driven run" {
 class: plain
 style: { font-size: 26; font-color: "#163047" }
 direction: right
 receive: "D · GPS task\nGPS::run() owns the loop\nReceive → parse → publish\nRepeat / block for more bytes" {class: d; width: 340; height: 185}
 process: "C · navigation worker\nVehicleGPSPosition::Run()\nCheck / select / blend GNSS\nPrepare measurement time" {class: c; width: 360; height: 185}
 topic: "vehicle_gnss\nuORB retained data\nNOT a thread\nNo EKF2 wake callback here" {class: topic; width: 340; height: 185}
 estimate: "B · SAME EKF2 instance\nOn an IMU-driven Run()\nRead new GNSS → buffer\nFuse when time / checks allow" {class: b; width: 355; height: 185}
 receive -> process: "sensor_gnss" {class: data}
 receive -> process: "schedule GNSS work" {class: wake}
 process -> topic: "publish" {class: data}
 topic -> estimate: "read\nNO wake" {class: data}
}
legend: "TEAL: uORB publication → retained data → later read.   ORANGE DASHED: schedule / wake only.   GREY: device / OS I/O.\nA–C each run WorkQueue::Run(): wait → dequeue → work-item Run() → repeat. C = wq:nav_and_controllers.\nuORB has no central broker thread. Flat build: shared address space, not a protected kernel/user crossing.\nDRDY count ≠ integration count ≠ main EKF step count. Timers, the manager and other firmware contexts are omitted." {style: {fill: "#F5F7FA";stroke: "#CFD8DC";font-size: 24;font-color: "#37474F";bold: false;border-radius: 10}}
