# Faithful D2 recreation of the PX4 Sensor-to-EKF Execution Map infographic.
# Source snapshot: PX4 b798249a, NuttX flat build, SENS_IMU_MODE=1.
vars: { d2-config: { layout-engine: elk; theme-id: 0 } }
grid-rows: 5
vertical-gap: 12
style: { fill: "#FFFFFF"; font-size: 18 }
classes: {
  band: { style: { border-radius: 12; stroke-width: 2; font-size: 18 } }
  node: { style: { fill: "#F8FBFF"; stroke: "#225EA8"; border-radius: 9; font-size: 18 } }
  loop: { style: { fill: "#FFFFFF"; stroke: "#8EA6B8"; border-radius: 8; font-size: 17 } }
  topic: { style: { fill: "#FFFFFF"; stroke: "#35AFA6"; border-radius: 7; font-size: 17 } }
  data: { style: { stroke: "#00897B"; font-color: "#00695C"; stroke-width: 3; font-size: 17 } }
  wake: { style: { stroke: "#F57C00"; font-color: "#E65100"; stroke-width: 3; stroke-dash: 6; font-size: 17 } }
  io: { style: { stroke: "#6B7D8A"; font-color: "#455A64"; stroke-width: 3; font-size: 17 } }
}
title: "PX4 Sensor-to-EKF Execution Map (NuttX, single-estimator example)" { shape: text; style: { font-size: 30; bold: true; font-color: "#0B2545" } }
subtitle: "Where the execution loops live, and how data travels from kernel/driver to PX4 modules" { shape: text; style: { font-size: 21; bold: true; font-color: "#0B2545" } }
hardware: "Hardware & NuttX services — flat build, shared address space" {
  class: band
  style: { fill: "#EAF4FD"; stroke: "#8CB9D9"; font-color: "#163047" }
  grid-rows: 2
  vertical-gap: 12
  devices: "" {
    grid-columns: 5
    horizontal-gap: 24
    style.opacity: 0
    imu: "SPI IMU\n(ICM42688P)\nFIFO + DRDY interrupt" { class: node; width: 245; height: 105 }
    spi: "NuttX SPI support\nspi_driver / DMA / bus" { class: node; width: 245; height: 105 }
    os: "NuttX scheduler, semaphores, interrupts, device drivers\nPX4 wq:* worker threads are separate from HPWORK / LPWORK" { class: node; width: 350; height: 105; style.fill: "#F3F8FD" }
    gnss: "GNSS receiver\n(u-blox, etc.)\nUART (UBX/NMEA)" { class: node; width: 245; height: 105 }
    uart: "NuttX UART driver\nserial IRQ + RX buffer" { class: node; width: 245; height: 105 }
  }
  note: "Flat build: one shared address space. This is a logical responsibility split, not a protected user/kernel boundary." {
    style: { fill: "#FFF7DD"; stroke: "#D6B65A"; border-radius: 8; font-size: 17; font-color: "#5D4037" }
  }
}
app: "PX4 application execution contexts" {
  class: band
  style: { fill: "#EAF7FF"; stroke: "#38A5DF"; font-color: "#163047" }
  grid-rows: 2
  vertical-gap: 16
  workers: "" {
    grid-columns: 4
    horizontal-gap: 24
    style.opacity: 0
    A: "A. wq:SPIx — PX4 worker thread\n(IMU driver runs here)" {
      style: { fill: "#E8F8E8"; stroke: "#52B85B"; border-radius: 10; font-size: 19; bold: true }
      grid-rows: 2
      vertical-gap: 12
      loop: "Work queue loop\nwait → dequeue → Run() → repeat" { class: loop; width: 290; height: 72 }
      drv: "ICM42688P::RunImpl()\nread FIFO / check errors\ndecode samples\npublish sensor_accel\npublish sensor_gyro" { class: node; width: 290; height: 155 }
    }
    B: "B. wq:INS0 — PX4 worker thread\nVehicleIMU and EKF2 share one thread" {
      style: { fill: "#FFE9EA"; stroke: "#FF6B6B"; border-radius: 10; font-size: 19; bold: true }
      grid-rows: 3
      vertical-gap: 10
      loop: "Work queue loop\nwait → dequeue → Run() → repeat" { class: loop; width: 300; height: 68 }
      vimu: "VehicleIMU::Run()\nread accel + gyro reports\nintegrate delta angle / velocity\npublish vehicle_imu\nwhen integration window ready" { class: node; width: 300; height: 140 }
      ekf: "EKF2::Run()\nsetIMUData(): output propagation\nmain update when downsample ready\npredict + fuse eligible inputs\npublish estimator outputs" { class: node; width: 300; height: 145 }
    }
    C: "C. wq:nav_and_controllers — PX4 worker\nSensors + VehicleGPSPosition share one thread" {
      style: { fill: "#FFF4D9"; stroke: "#F4C542"; border-radius: 10; font-size: 19; bold: true }
      grid-rows: 3
      vertical-gap: 10
      loop: "Work queue loop\nwait → dequeue → Run() → repeat" { class: loop; width: 310; height: 68 }
      sensors: "Sensors::Run()\nselect / vote IMU(s)\npublish sensor_combined" { class: node; width: 310; height: 110 }
      gpspos: "VehicleGPSPosition::Run()\ncheck / select GNSS\ntime alignment / validation\npublish vehicle_gnss" { class: node; width: 310; height: 125 }
    }
    D: "D. GPS task — dedicated task\nblocking receive loop" {
      style: { fill: "#F2E8FA"; stroke: "#A070DB"; border-radius: 10; font-size: 19; bold: true }
      grid-rows: 2
      vertical-gap: 12
      loop: "Task loop\nwait for bytes → parse → publish → repeat" { class: loop; width: 285; height: 72 }
      gpsrun: "GPS::run()\nread UART (blocking)\nparse UBX / NMEA\npublish sensor_gnss\nwhen a complete solution is available" { class: node; width: 285; height: 155 }
    }
  }
  uorb: "uORB topic storage — retained typed data + notifications; NOT a thread" {
    style: { fill: "#DFF5F2"; stroke: "#22A69A"; border-radius: 10; font-size: 20; bold: true; font-color: "#163047" }
    grid-columns: 7
    horizontal-gap: 16
    accel: "sensor_accel" { class: topic; width: 180; height: 50 }
    gyro: "sensor_gyro" { class: topic; width: 180; height: 50 }
    vimu: "vehicle_imu" { class: topic; width: 180; height: 50 }
    combined: "sensor_combined" { class: topic; width: 180; height: 50 }
    vgnss: "vehicle_gnss" { class: topic; width: 180; height: 50 }
    sgnss: "sensor_gnss" { class: topic; width: 180; height: 50 }
    more: "…" { class: topic; width: 120; height: 50 }
  }
}
hardware.devices.imu <-> hardware.devices.spi: "SPI bus bytes" { class: io }
hardware.devices.gnss <-> hardware.devices.uart: "UART RX bytes" { class: io }
hardware.devices.imu -> app.workers.A.drv: "1. DRDY interrupt\ntimestamp + ScheduleNow()\nDoes NOT execute EKF" { class: wake }
hardware.devices.uart -> app.workers.D.gpsrun: "UART data available\nwake via read/poll" { class: io }
app.workers.A.drv -> app.uorb.accel: "publish" { class: data }
app.workers.A.drv -> app.uorb.gyro: "publish" { class: data }
app.uorb.gyro -> app.workers.B.vimu: "read" { class: data }
app.workers.A.drv -> app.workers.B.vimu: "2. schedule VehicleIMU" { class: wake }
app.workers.B.vimu -> app.uorb.vimu: "publish" { class: data }
app.uorb.vimu -> app.workers.C.sensors: "read" { class: data }
app.workers.B.vimu -> app.workers.C.sensors: "3. schedule Sensors" { class: wake }
app.workers.C.sensors -> app.uorb.combined: "publish" { class: data }
app.uorb.combined -> app.workers.B.ekf: "read" { class: data }
app.workers.C.sensors -> app.workers.B.ekf: "5. schedule EKF2" { class: wake }
app.workers.D.gpsrun -> app.uorb.sgnss: "publish" { class: data }
app.uorb.sgnss -> app.workers.C.gpspos: "read" { class: data }
app.workers.D.gpsrun -> app.workers.C.gpspos: "6. schedule VehicleGPSPosition" { class: wake }
app.workers.C.gpspos -> app.uorb.vgnss: "publish" { class: data }
app.uorb.vgnss -> app.workers.B.ekf: "read on IMU run\nNO GNSS-triggered EKF wake" { class: data }
bottom: "" {
  grid-columns: 3
  horizontal-gap: 18
  style.opacity: 0
  legend: "Legend\nTEAL: topic data flow (uORB publish/read)\nORANGE DASHED: scheduling / wake only\nGREY: device bytes / OS I/O" { style: { fill: "#FFFFFF"; stroke: "#B8C5CF"; border-radius: 9; font-size: 17; font-color: "#163047" }; width: 430; height: 120 }
  orbnote: "uORB = retained typed data + notification\n• publish copies data into topic storage\n• callback usually calls ScheduleNow() on subscriber work item\n• consumer runs later in its worker and reads data\n• there is no central uORB broker thread" { style: { fill: "#E8F3FF"; stroke: "#8CB9D9"; border-radius: 9; font-size: 17; font-color: "#163047" }; width: 560; height: 120 }
  key: "Key points\n• four sensor-to-EKF processing contexts shown\n• PX4 worker threads are not NuttX HPWORK/LPWORK\n• DRDY schedules the driver, not EKF\n• GNSS does not wake EKF in this path\n• other firmware contexts are omitted" { style: { fill: "#FFE9EA"; stroke: "#FF8A95"; border-radius: 9; font-size: 17; font-color: "#163047" }; width: 470; height: 120 }
}