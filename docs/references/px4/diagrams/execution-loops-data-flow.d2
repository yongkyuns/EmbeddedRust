# PX4 b798249a; NuttX flat build; SENS_IMU_MODE=1. Not a firmware timing trace.
# Wiring rule: regular ELK graphs inside each row, never cross-grid connections.
vars: { d2-config: { layout-engine: elk; theme-id: 0 } }
grid-columns: 1
vertical-gap: 14
style.fill: "#FFFFFF"
classes: {
  plain: { style: { fill: "transparent"; stroke: "transparent" } }
  hw: { style: { fill: "#ECEFF1"; stroke: "#607D8B"; font-color: "#263238"; border-radius: 10; font-size: 26; bold: false } }
  a: { style: { fill: "#E8F5E9"; stroke: "#388E3C"; font-color: "#1B5E20"; border-radius: 10; font-size: 26; bold: false } }
  b: { style: { fill: "#E8EAF6"; stroke: "#5C6BC0"; font-color: "#283593"; border-radius: 10; font-size: 26; bold: false } }
  c: { style: { fill: "#FFF3E0"; stroke: "#FB8C00"; font-color: "#6D4C41"; border-radius: 10; font-size: 26; bold: false } }
  d: { style: { fill: "#F3E5F5"; stroke: "#AB47BC"; font-color: "#6A1B9A"; border-radius: 10; font-size: 26; bold: false } }
  e: { style: { fill: "#E3F2FD"; stroke: "#1E88E5"; font-color: "#0D47A1"; border-radius: 10; font-size: 26; bold: false } }
  topic: { style: { fill: "#E0F2F1"; stroke: "#00897B"; font-color: "#004D40"; border-radius: 10; font-size: 26; bold: false } }
  data: { style: { stroke: "#00897B"; font-color: "#00695C"; stroke-width: 3; font-size: 24 } }
  wake: { style: { stroke: "#E65100"; font-color: "#BF360C"; stroke-dash: 5; stroke-width: 3; font-size: 24 } }
  io: { style: { stroke: "#607D8B"; font-color: "#455A64"; stroke-width: 3; font-size: 24 } }
  call: { style: { stroke: "#5C6BC0"; font-color: "#3949AB"; stroke-width: 2; font-size: 24 } }
}

title: "PX4 execution loops: who owns each Run()?" { shape: text; style: {font-size: 38;bold: true;font-color: "#163047"} }
scope: "One card = one OS execution context. Nested boxes = ordinary work items, NOT extra threads.\nSingle-estimator example; control-side worker E is included. This is not the full firmware thread count." {shape: text;style: {font-size: 26;font-color: "#455A64"}}
os: "NuttX schedules these contexts and provides interrupts, SPI/UART, semaphores and timers.\nPX4 wq:* ≠ NuttX HPWORK / LPWORK. Flat build: one shared address space." {style: {fill: "#ECEFF1";stroke: "#90A4AE";font-size: 26;font-color: "#37474F";border-radius: 10}}
contexts: "" {
 class: plain
 grid-columns: 5
 horizontal-gap: 22
 A: "A · wq:SPIx" {
  class: a
  grid-columns: 1
  vertical-gap: 16
  loop: "WorkQueue::Run()\nwait → dequeue\nRun() → repeat" {width: 295;height: 120;style: {font-size: 26;fill: "#FFFFFF";stroke: "#A5D6A7";border-radius: 8;bold: false}}
  driver: "ICM42688P::RunImpl()\nRead SPI FIFO\nDecode / check\nPublish accel + gyro" {width: 295;height: 170;style: {font-size: 26;fill: "#FFFFFF";stroke: "#A5D6A7";border-radius: 8;bold: false}}
  trigger: "Wake: DRDY or timer\nNo EKF code in ISR" {shape: text;style: {font-size: 24;bold: false}}
 }
 B: "B · wq:INS0" {
  class: b
  grid-columns: 1
  vertical-gap: 16
  loop: "WorkQueue::Run()\nwait → dequeue\nRun() → repeat" {width: 295;height: 120;style: {font-size: 26;fill: "#FFFFFF";stroke: "#9FA8DA";border-radius: 8;bold: false}}
  imu: "VehicleIMU::Run()\nCalibrate / integrate\nOutput: vehicle_imu" {width: 295;height: 128;style: {font-size: 26;fill: "#FFFFFF";stroke: "#9FA8DA";border-radius: 8;bold: false}}
  ekf: "EKF2::Run()\nIMU input + other aids\nOutput predictor / EKF" {width: 295;height: 128;style: {font-size: 26;fill: "#FFFFFF";stroke: "#9FA8DA";border-radius: 8;bold: false}}
  serial: "Same thread / stack\nSeparate Run() calls" {shape: text;style: {font-size: 24;bold: false}}
 }
 C: "C · navigation worker" {
  class: c
  grid-columns: 1
  vertical-gap: 16
  loop: "WorkQueue::Run()\nwait → dequeue\nRun() → repeat" {width: 295;height: 120;style: {font-size: 26;fill: "#FFFFFF";stroke: "#FFCC80";border-radius: 8;bold: false}}
  sensors: "Sensors::Run()\nIMU voter\nOutput: sensor_combined" {width: 295;height: 128;style: {font-size: 26;fill: "#FFFFFF";stroke: "#FFCC80";border-radius: 8;bold: false}}
  gnss: "VehicleGPSPosition\nGNSS checks / selection\nOutput: vehicle_gnss" {width: 295;height: 128;style: {font-size: 26;fill: "#FFFFFF";stroke: "#FFCC80";border-radius: 8;bold: false}}
  outer: "Position + attitude control\nOther work items here" {shape: text;style: {font-size: 24;bold: false}}
 }
 D: "D · GPS task" {
  class: d
  grid-columns: 1
  vertical-gap: 16
  loop: "GPS::run() owns loop\nreceive → parse\npublish → repeat" {width: 295;height: 120;style: {font-size: 26;fill: "#FFFFFF";stroke: "#CE93D8";border-radius: 8;bold: false}}
  parser: "Protocol helper\nUBX / NMEA / etc.\nComplete GNSS solution\nOutput: sensor_gnss" {width: 295;height: 170;style: {font-size: 26;fill: "#FFFFFF";stroke: "#CE93D8";border-radius: 8;bold: false}}
  wait: "May block on UART\nNo separate fusion loop" {shape: text;style: {font-size: 24;bold: false}}
 }
 E: "E · wq:rate_ctrl" {
  class: e
  grid-columns: 1
  vertical-gap: 16
  loop: "WorkQueue::Run()\nwait → dequeue\nRun() → repeat" {width: 295;height: 120;style: {font-size: 26;fill: "#FFFFFF";stroke: "#90CAF9";border-radius: 8;bold: false}}
  gyro: "VehicleAngularVelocity\nGyro filtering\nvehicle_angular_velocity" {width: 295;height: 128;style: {font-size: 26;fill: "#FFFFFF";stroke: "#90CAF9";border-radius: 8;bold: false}}
  control: "MulticopterRateControl\nControlAllocator\nSeparate work items" {width: 295;height: 128;style: {font-size: 26;fill: "#FFFFFF";stroke: "#90CAF9";border-radius: 8;bold: false}}
  serial: "Same thread / stack\nNo extra loop per item" {shape: text;style: {font-size: 24;bold: false}}
 }
}
fast: "FAST CONTROL DATA PATH — E is the same worker throughout, not three threads" {
 class: plain
 style: {font-size: 26;font-color: "#163047"}
 direction: right
 input: "Gyro report\nfrom A / bus driver" {class: a;width: 280;height: 125}
 gyro: "E · gyro processing\nVehicleAngularVelocity" {class: e;width: 290;height: 125}
 rate: "E · rate controller\nAvailable setpoint" {class: e;width: 280;height: 125}
 alloc: "E · ControlAllocator\nMotor / servo commands" {class: e;width: 290;height: 125}
 output: "Output drivers\nPWM / DShot / etc.\nTarget-specific context" {class: hw;width: 290;height: 125}
 input -> gyro: "gyro / FIFO" {class: data}
 gyro -> rate: "angular\nvelocity" {class: data}
 rate -> alloc: "torque /\nthrust" {class: data}
 alloc -> output: "motor /\nservo" {class: data}
}
notes: "CONTAINMENT shows ownership; no scheduler-to-every-module wires are needed. Cards do not prescribe dispatch order.\nC = wq:nav_and_controllers. A/B/C/D names match the sensor-to-EKF map and sequence view.\nuORB retains data and notifies subscribers; it is not another card or execution loop. Teal links above are data flow only." {style: {fill: "#F5F7FA";stroke: "#CFD8DC";font-size: 24;font-color: "#37474F";bold: false;border-radius: 10}}
