# PX4 b798249a; NuttX flat build; SENS_IMU_MODE=1. Not a firmware timing trace.
# Wiring rule: regular ELK graphs inside each row, never cross-grid connections.
vars: { d2-config: { layout-engine: elk; theme-id: 0 } }
grid-columns: 1
vertical-gap: 14
style.fill: "#FFFFFF"
classes: {
  plain: { style: { fill: "transparent"; stroke: "transparent" } }
  hw: { style: { fill: "#ECEFF1"; stroke: "#607D8B"; font-color: "#263238"; border-radius: 10; font-size: 26; bold: false } }
  a: { style: { fill: "#E8F5E9"; stroke: "#388E3C"; font-color: "#1B5E20"; border-radius: 10; font-size: 26; bold: false } }
  b: { style: { fill: "#E8EAF6"; stroke: "#5C6BC0"; font-color: "#283593"; border-radius: 10; font-size: 26; bold: false } }
  c: { style: { fill: "#FFF3E0"; stroke: "#FB8C00"; font-color: "#6D4C41"; border-radius: 10; font-size: 26; bold: false } }
  d: { style: { fill: "#F3E5F5"; stroke: "#AB47BC"; font-color: "#6A1B9A"; border-radius: 10; font-size: 26; bold: false } }
  e: { style: { fill: "#E3F2FD"; stroke: "#1E88E5"; font-color: "#0D47A1"; border-radius: 10; font-size: 26; bold: false } }
  topic: { style: { fill: "#E0F2F1"; stroke: "#00897B"; font-color: "#004D40"; border-radius: 10; font-size: 26; bold: false } }
  data: { style: { stroke: "#00897B"; font-color: "#00695C"; stroke-width: 3; font-size: 24 } }
  wake: { style: { stroke: "#E65100"; font-color: "#BF360C"; stroke-dash: 5; stroke-width: 3; font-size: 24 } }
  io: { style: { stroke: "#607D8B"; font-color: "#455A64"; stroke-width: 3; font-size: 24 } }
  call: { style: { stroke: "#5C6BC0"; font-color: "#3949AB"; stroke-width: 2; font-size: 24 } }
}

title: "PX4: four execution loops, one sensor-to-estimator trace" { shape: text; style: {font-size: 38;bold: true;font-color: "#163047"} }
scope: "NuttX flat build · SENS_IMU_MODE=1 · one SPI IMU + one UART GNSS · PX4 b798249a\nFive lifelines below: IRQ / OS services are NOT a fifth processing thread." {shape: text;style: {font-size: 26;font-color: "#455A64"}}
trace: "" {
 shape: sequence_diagram
 class: plain
 os: "IRQ / OS services\nNuttX + PX4 ISR\nSPI / UART support" {class: hw;width: 330;height: 135}
 a: "A · wq:SPIx\nWorkQueue::Run()\nIMU driver" {class: a;width: 330;height: 135}
 b: "B · wq:INS0\nWorkQueue::Run()\nVehicleIMU + EKF2" {class: b;width: 330;height: 135}
 c: "C · navigation worker\nWorkQueue::Run()\nSensors + GNSS processing" {class: c;width: 355;height: 135}
 d: "D · GPS task\nGPS::run()\nBlocking receive loop" {class: d;width: 330;height: 135}
 imu: "IMU — causal handoffs, not a wall-clock timing guarantee" {
  style: {fill: "#F7F9FD";stroke: "#CFD8DC";font-color: "#455A64";font-size: 24}
  os -> a: "1  DRDY: timestamp + ScheduleNow()" {class: wake}
  a -> b: "2  accel/gyro data; wake VehicleIMU" {class: data}
  b -> c: "3  vehicle_imu; wake Sensors" {class: data}
  c -> b: "4  sensor_combined; wake EKF2" {class: data}
 }
 gnss: "GNSS — independent arrival; not required to occur after the IMU example" {
  style: {fill: "#FBF6FC";stroke: "#CFD8DC";font-color: "#455A64";font-size: 24}
  os -> d: "5  UART RX buffer → read/poll wakes GPS task" {class: io}
  d -> c: "6  sensor_gnss; wake GNSS processing" {class: data}
  c -> b: "7  vehicle_gnss: IMU-run read; NO wake" {class: data}
 }
}
notes: "TEAL: topic publication + later consumer read; callback scheduling is stated in the label. ORANGE: wake only. GREY: OS I/O.\nA reads SPI FIFO via NuttX, then publishes sensor_accel / sensor_gyro. B runs VehicleIMU, then later EKF2.\nsetIMUData() propagates output; the main EKF step waits for downsampled IMU readiness.\nGNSS ingestion and fusion remain in EKF2's context. uORB and the output predictor have NO independent thread here.\nA–C: wait → dequeue → Run() → repeat. C = wq:nav_and_controllers. Other firmware loops and backup timers are omitted." {style: {fill: "#F5F7FA";stroke: "#CFD8DC";font-size: 24;font-color: "#37474F";bold: false;border-radius: 10}}
